# URL de l'API groupegenetics-api, vue depuis le NAVIGATEUR
# (les appels partent du navigateur, donc pas de nom de service Docker ici).
# Cette valeur est intégrée au build : relancer `docker compose up --build` après modification.
NEXT_PUBLIC_API_URL=http://localhost:8000

# Port exposé sur la machine hôte
ADMIN_PORT=3000
